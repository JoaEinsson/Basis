{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Basis",
  "version": "0.2.0",
  "identifier": "io.github.joaeinsson.basis",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Basis",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 560,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; media-src 'self' asset:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "devCsp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://localhost:1420 http://127.0.0.1:1420 ws://localhost:1420 ws://127.0.0.1:1420; font-src 'self' data:; media-src 'self' asset:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "copyright": "Copyright 2026 JoaEinsson",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzM0Y0NDA2QkE4MEI2QTkKUldTcHRvQzZCa1EvRTRoT1owQjFHTW8zQXdvMzhDMWZScnF1QXhoWDNoQXIrZFA5bXFyaDBsV0UK",
      "endpoints": [
        "https://github.com/JoaEinsson/Basis/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
