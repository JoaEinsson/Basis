{
  "$schema": "https://raw.githubusercontent.com/JoaEinsson/Basis/main/schemas/basis-theme.schema.v1.json",
  "format": "basis-theme",
  "schema_version": 1,
  "id": "builtin:nocturne",
  "name": "Nocturne",
  "author": "Basis",
  "based_on": null,
  "appearance": "dark",
  "min_app_version": "0.1.0",
  "capabilities": [],
  "tokens": {
    "color.background.canvas": "#0c0d10",
    "color.background.surface": "#15171c",
    "color.background.overlay": "#1c1f26",
    "color.background.input": "#15171c",
    "color.interaction.hover": "#24262d",
    "color.text.primary": "#f4f5f7",
    "color.text.secondary": "#a9afbd",
    "color.text.tertiary": "#747b8d",
    "color.text.disabled": "#747b8d",
    "color.accent.primary": "#49d9c7",
    "color.accent.onAccent": "#0c0d10",
    "color.selection.background": "#123734",
    "color.selection.foreground": "#f4f5f7",
    "color.border.default": "#2d3039",
    "color.focus.ring": "#a5f4e6",
    "color.status.error": "#ff9b9b",
    "color.favorite": "#ff87ae",
    "color.artwork.fallbackStart": "#282c38",
    "color.artwork.fallbackEnd": "#161820",
    "shape.radius.control": 7,
    "shape.radius.surface": 12,
    "shape.radius.artwork": 6,
    "elevation.surface": "0 18px 50px #0000004d",
    "effects.backdropBlur": 18,
    "effects.ambientGlowStrength": 0.12,
    "density.scale": 1,
    "motion.duration.fast": 120,
    "motion.duration.normal": 190
  },
  "behavior": {
    "accent_source": "fixed",
    "contrast_policy": "correct-critical"
