{
  "$schema": "https://raw.githubusercontent.com/JoaEinsson/Basis/main/schemas/basis-theme.schema.v1.json",
  "format": "basis-theme",
  "schema_version": 1,
  "id": "builtin:paper",
  "name": "Paper",
  "author": "Basis",
  "based_on": null,
  "appearance": "light",
  "min_app_version": "0.1.0",
  "capabilities": [],
  "tokens": {
    "color.background.canvas": "#f7f7f5",
    "color.background.surface": "#ffffff",
    "color.background.overlay": "#ffffff",
    "color.background.input": "#ffffff",
    "color.interaction.hover": "#ededeb",
    "color.text.primary": "#202124",
    "color.text.secondary": "#5f6368",
    "color.text.tertiary": "#74777d",
    "color.text.disabled": "#8b8e93",
    "color.accent.primary": "#4056b4",
    "color.accent.onAccent": "#ffffff",
    "color.selection.background": "#dfe4ff",
    "color.selection.foreground": "#202124",
    "color.border.default": "#d8d9dc",
    "color.focus.ring": "#4056b4",
    "color.status.error": "#b3261e",
    "color.favorite": "#a73562",
    "color.artwork.fallbackStart": "#e1e3e9",
    "color.artwork.fallbackEnd": "#cdd1dc",
    "shape.radius.control": 6,
    "shape.radius.surface": 8,
    "shape.radius.artwork": 6,
    "elevation.surface": "0 10px 30px #2424241a",
    "effects.backdropBlur": 0,
    "effects.ambientGlowStrength": 0,
    "density.scale": 0.94,
    "motion.duration.fast": 100,
    "motion.duration.normal": 160
  },
  "behavior": {
    "accent_source": "fixed",
    "contrast_policy": "correct-critical"
  }
}
